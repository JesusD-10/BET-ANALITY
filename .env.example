APP_ENV=development
DEBUG=true

FRONTEND_URL=https://bet-anality-1.onrender.com
NEXT_PUBLIC_API_URL=https://bet-anality.onrender.com/api/v1
# Motor multi-IA (hasta cuatro proveedores en paralelo por análisis)
AI_ENABLED=true
AI_ALLOW_PAID_PROVIDERS=true
AI_PROVIDER_TIMEOUT_SECONDS=18
AI_TOTAL_TIMEOUT_SECONDS=22
AI_MAX_PROVIDER_ATTEMPTS=4

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://bet-anality-1.onrender.com

# Solo diagnóstico: GitHub Models inference fue retirado el 30-07-2026.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=retired
# API-SPORTS directo (también acepta SPORTS_DATA_PROVIDER=api-sports)
SPORTS_DATA_PROVIDER=api-football
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_IS_RAPIDAPI=false
API_FOOTBALL_TIMEOUT_SECONDS=10

# Segundo proveedor: Sportmonks Football API v3
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_SECONDS=15

# Último respaldo: football-data.org
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_TIMEOUT_SECONDS=10

# Presupuesto máximo de la cadena secuencial de datos deportivos
SPORTS_DATA_TOTAL_TIMEOUT_SECONDS=40
